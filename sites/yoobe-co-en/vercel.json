{
	"cleanUrls": true,
	"trailingSlash": false,
	"redirects": [
		{ "source": "/en", "destination": "/", "permanent": true },
		{ "source": "/en/:path*", "destination": "/", "permanent": true },
		{ "source": "/es", "destination": "/", "permanent": true },
		{ "source": "/es/:path*", "destination": "/", "permanent": true },
		{
			"source": "/loja-corporativa",
			"destination": "https://corporate.yoobe.co/platform/rewards-store/",
			"permanent": true
		},
		{
			"source": "/estoque-e-logistica",
			"destination": "https://corporate.yoobe.co/platform/logistics/",
			"permanent": true
		}
	]
}
