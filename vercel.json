{
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "framework": null,
  "routes": [
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "yoobe.co" }],
      "status": 308,
      "headers": { "Location": "https://www.yoobe.co/$1" }
    },
    { "handle": "filesystem" },
    { "src": "/studio/(.*)", "dest": "/studio/index.html" },
    { "src": "/(.*[^/])", "status": 308, "headers": { "Location": "/$1/" } },
    { "src": "/(.*)", "status": 404, "dest": "/404.html" }
  ]
}
