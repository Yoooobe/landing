{
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "framework": null,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "yoobe.co" }],
      "destination": "https://www.yoobe.co/:path*",
      "permanent": true
    }
  ]
}
