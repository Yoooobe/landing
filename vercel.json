{
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "framework": null,
  "routes": [
    {
      "src": "/gamification/?",
      "status": 308,
      "headers": {
        "Location": "/platform/gamification-engine/"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/studio/(.*)",
      "dest": "/studio/index.html"
    },
    {
      "src": "/(.*[^/])",
      "status": 308,
      "headers": {
        "Location": "/$1/"
      }
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
